# ============================================================================
# NSSCP (National Smart Security & Control Platform) — Environment Config
# ============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================================

# ─── PostgreSQL ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nsscp_db?schema=public"

# ─── JWT Authentication ─────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="your-refresh-secret-at-least-32-characters-long"
JWT_EXPIRATION="24h"
JWT_REFRESH_EXPIRATION="7d"

# ─── Session ────────────────────────────────────────────────────────────
SESSION_SECRET="your-session-secret-at-least-32-characters"

# ─── Application ────────────────────────────────────────────────────────
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ─── Redis (Rate Limiting) — optional, falls back to in-memory ──────────
REDIS_URL="redis://localhost:6379"