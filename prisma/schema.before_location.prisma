generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ADMIN USER
//////////////////////////////////////////////////////

model AdminUser {
  id       String  @id @default(uuid())
  username String  @unique
  password String
  role     String  @default("admin")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////////

model AuditLog {
  id String @id @default(uuid())

  action     String
  entityType String
  entityId   String

  officerId String?
  userId    String?

  details   Json?
  ipAddress String?
  userAgent String?

  hierarchyEntityId   String?
  hierarchyEntityType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Officer Officer? @relation(fields: [officerId], references: [id])
  User    User?    @relation(fields: [userId], references: [id])
}

//////////////////////////////////////////////////////
// USER + RBAC (مُحدّث بالكامل للمرحلة 1 و 2)
//////////////////////////////////////////////////////

model User {
  id       String @id @default(uuid())
  username String @unique
  password String // مشفرة بـ bcryptjs

  // --- حقول إلزامية جديدة (المرحلة 2) ---
  fullName       String // الاسم الكامل
  militaryNumber String @unique // الرقم العسكري
  rank           String // الرتبة (مثال: ملازم، نقيب، عقيد)
  position       String // المنصب (مثال: مدير أمن المحافظة، ضابط عمليات)
  province       String // المحافظة (نص واضح للتخزين المباشر)
  department     String // الإدارة (نص واضح للتخزين المباشر)
  // ----------------------------------------

  role     UserRole @default(VIEWER)
  isActive Boolean  @default(true)

  email       String?
  phoneNumber String?
  avatar      String?

  governorateId   String?
  districtId      String?
  policeStationId String?

  Governorate   Governorate?   @relation(fields: [governorateId], references: [id])
  District      District?      @relation(fields: [districtId], references: [id])
  PoliceStation PoliceStation? @relation(fields: [policeStationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  AuditLog       AuditLog[]
  UserPermission UserPermission[]
  Officer        Officer?
}

//////////////////////////////////////////////////////
// ROLE
//////////////////////////////////////////////////////

model Role {
  id          String   @id @default(uuid())
  name        UserRole @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  RolePermission RolePermission[]
  UserPermission UserPermission[]
}

//////////////////////////////////////////////////////
// PERMISSION
//////////////////////////////////////////////////////

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  RolePermission RolePermission[]
  UserPermission UserPermission[]
}

//////////////////////////////////////////////////////
// ROLE PERMISSION
//////////////////////////////////////////////////////

model RolePermission {
  roleId       String
  permissionId String

  createdAt DateTime @default(now())

  Role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  Permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

//////////////////////////////////////////////////////
// USER PERMISSION
//////////////////////////////////////////////////////

model UserPermission {
  id String @id @default(uuid())

  userId       String
  permissionId String

  User       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  Permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  Role       Role?      @relation(fields: [roleId], references: [id])
  roleId     String?

  @@unique([userId, permissionId])
}

//////////////////////////////////////////////////////
// GOVERNORATE
//////////////////////////////////////////////////////

model Governorate {
  id   String @id @default(uuid())
  name String
  code String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User          User[]
  District      District[]
  PoliceStation PoliceStation[]
  Officer       Officer[]
  Case          Case[]
}

//////////////////////////////////////////////////////
// DISTRICT
//////////////////////////////////////////////////////

model District {
  id   String @id @default(uuid())
  name String
  code String @unique

  governorateId String
  Governorate   Governorate @relation(fields: [governorateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Case          Case[]
  Officer       Officer[]
  User          User[]
  PoliceStation PoliceStation[]
}

//////////////////////////////////////////////////////
// POLICE STATION
//////////////////////////////////////////////////////

model PoliceStation {
  id   String @id @default(uuid())
  name String
  code String @unique

  governorateId String
  districtId    String?

  Governorate Governorate @relation(fields: [governorateId], references: [id])
  District    District?   @relation(fields: [districtId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Department Department[]
  Officer    Officer[]
  User       User[]
}

//////////////////////////////////////////////////////
// OFFICER
//////////////////////////////////////////////////////

model Officer {
  id          String @id @default(uuid())
  fullName    String
  badgeNumber String @unique
  rank        String

  email       String?
  phoneNumber String?
  isActive    Boolean @default(true)

  userId String? @unique
  User   User?   @relation(fields: [userId], references: [id])

  governorateId   String?
  districtId      String?
  policeStationId String?
  departmentId    String?

  Governorate   Governorate?   @relation(fields: [governorateId], references: [id])
  District      District?      @relation(fields: [districtId], references: [id])
  PoliceStation PoliceStation? @relation(fields: [policeStationId], references: [id])
  Department    Department?    @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  AuditLog       AuditLog[]
  CaseAssignment CaseAssignment[]
}

//////////////////////////////////////////////////////
// CASE
//////////////////////////////////////////////////////

model Case {
  id          String  @id @default(uuid())
  caseNumber  String  @unique
  title       String
  description String?

  caseType String
  status   String @default("open")
  priority String @default("medium")

  governorateId String?
  districtId    String?

  Governorate Governorate? @relation(fields: [governorateId], references: [id])
  District    District?    @relation(fields: [districtId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  CaseAssignment CaseAssignment[]
}

//////////////////////////////////////////////////////
// CASE ASSIGNMENT
//////////////////////////////////////////////////////

model CaseAssignment {
  id        String @id @default(uuid())
  caseId    String
  officerId String

  role String @default("investigator")

  Case    Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  Officer Officer @relation(fields: [officerId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([caseId, officerId])
}

//////////////////////////////////////////////////////
// SIMPLE TABLES (مختصرة)
//////////////////////////////////////////////////////

model Department {
  id   String @id @default(uuid())
  name String
  code String @unique

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  PoliceStation   PoliceStation? @relation(fields: [policeStationId], references: [id])
  policeStationId String?
  Officer         Officer[]
}

//////////////////////////////////////////////////////
// ENUM
//////////////////////////////////////////////////////

enum UserRole {
  SUPER_ADMIN
  MINISTRY_ADMIN
  GOVERNORATE_ADMIN
  DISTRICT_ADMIN
  POLICE_ADMIN
  OFFICER
  VIEWER
}
