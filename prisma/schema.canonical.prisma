datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Canonical NSSCP Prisma schema (production baseline)

// Enums
enum UserRole {
  SUPER_ADMIN
  MINISTRY_ADMIN
  GOVERNORATE_ADMIN
  DISTRICT_ADMIN
  POLICE_ADMIN
  OFFICER
  VIEWER
}

enum HierarchyType {
  MINISTRY
  GOVERNORATE
  DEPARTMENT
  SECTION
  UNIT
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  TEXTAREA
  FILE
  IMAGE
}

enum CaseStatus {
  OPEN
  UNDER_INVESTIGATION
  PENDING_REVIEW
  CLOSED
  ARCHIVED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentType {
  THEFT
  ASSAULT
  TRAFFIC_ACCIDENT
  DOMESTIC_VIOLENCE
  NARCOTICS
  FRAUD
  HOMICIDE
  PUBLIC_DISTURBANCE
  OTHER
}

enum IncidentStatus {
  REPORTED
  UNDER_INVESTIGATION
  RESOLVED
  UNFOUNDED
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  REJECTED
}

enum CellType {
  SINGLE
  SHARED
  HIGH_SECURITY
  SOLITARY_CONFINEMENT
  MEDICAL
}

enum PrisonerStatus {
  REMAND
  SENTENCED
  PAROLE
  ESCAPED
  DECEASED
  RELEASED
  TRANSFERRED
}

enum OperationStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
  STANDING_BY
}

enum PatrolStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  ON_BREAK
}

enum EmergencyCallStatus {
  RECEIVED
  DISPATCHED
  ON_SCENE
  RESOLVED
  CANCELLED
}

enum TrafficViolationStatus {
  ISSUED
  PAID
  DISPUTED
  DISMISSED
  REFERRED_TO_COURT
}

// Identity & RBAC
model User {
  id           String  @id @default(cuid())
  username     String  @unique
  email        String? @unique
  passwordHash String
  fullName     String?
  nationalId   String? @unique
  militaryId   String? @unique
  role         Role?   @relation("PrimaryRole", fields: [roleId], references: [id])
  roleId       String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  governorateId String?
  stationId     String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles             Role[]           @relation("UserRoles")
  permissions       Permission[]     @relation("UserPermissions")
  auditLogs         AuditLog[]
  HierarchyEntity   HierarchyEntity? @relation(fields: [hierarchyEntityId], references: [id])
  hierarchyEntityId String?
  HierarchyUser     HierarchyUser[]
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  users           User[]           @relation("UserRoles")
  primaryUsers    User[]           @relation("PrimaryRole")
  permissions     Permission[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  resource        String
  action          String
  roles           Role[]
  users           User[]           @relation("UserPermissions")
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  granted      Boolean    @default(true)
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())
}

// National Organization
model Governorate {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  districts   District[]
  departments Department[]
}

model District {
  id            String      @id @default(cuid())
  name          String
  code          String      @unique
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id])
}

model Department {
  id            String       @id @default(cuid())
  name          String
  code          String?      @unique
  governorateId String?
  governorate   Governorate? @relation(fields: [governorateId], references: [id])
  users         User[]
}

// Hierarchy
model HierarchyEntity {
  id            String            @id @default(cuid())
  name          String
  code          String?           @unique
  type          HierarchyType
  parentId      String?
  parent        HierarchyEntity?  @relation("HierarchyParent", fields: [parentId], references: [id])
  children      HierarchyEntity[] @relation("HierarchyParent")
  users         User[]
  HierarchyUser HierarchyUser[]
}

model HierarchyUser {
  id         String          @id @default(cuid())
  userId     String
  entityId   String
  user       User            @relation(fields: [userId], references: [id])
  entity     HierarchyEntity @relation(fields: [entityId], references: [id])
  assignedAt DateTime        @default(now())
}

// Dynamic forms
model DynamicForm {
  id           String         @id @default(cuid())
  name         String
  schema       Json
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  FormTemplate FormTemplate[]
}

model FormTemplate {
  id            String       @id @default(cuid())
  name          String
  description   String?
  dynamicForm   DynamicForm? @relation(fields: [dynamicFormId], references: [id])
  dynamicFormId String?
}

model FormSubmission {
  id          String   @id @default(cuid())
  templateId  String
  data        Json
  submittedBy String?
  createdAt   DateTime @default(now())
}

model FormAttachment {
  id           String @id @default(cuid())
  submissionId String
  filename     String
  url          String
}

model FormSignature {
  id           String @id @default(cuid())
  submissionId String
  signerId     String
  signature    String
}

model FormApproval {
  id           String @id @default(cuid())
  submissionId String
  approverId   String
  status       String
}

// Archive
model ArchiveFolder {
  id       String  @id @default(cuid())
  name     String
  parentId String?
}

model ArchiveDocument {
  id        String   @id @default(cuid())
  title     String
  folderId  String?
  createdBy String?
  createdAt DateTime @default(now())
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  versionIndex Int
  contentUrl   String
  createdAt    DateTime @default(now())
}

// Cases / Investigations / Evidence
model Case {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      CaseStatus    @default(OPEN)
  priority    CasePriority?
  createdBy   String?
  createdAt   DateTime      @default(now())
}

model Investigation {
  id        String   @id @default(cuid())
  caseId    String
  leadId    String?
  status    String
  createdAt DateTime @default(now())
}

model Evidence {
  id          String  @id @default(cuid())
  caseId      String
  description String?
  storedAt    String?
}

model CrimeScene {
  id       String  @id @default(cuid())
  caseId   String
  location String?
}

// Wanted persons
model WantedPerson {
  id        String   @id @default(cuid())
  name      String
  aliases   String?
  createdAt DateTime @default(now())
}

// Operations / Patrols / Incidents
model Operation {
  id        String          @id @default(cuid())
  name      String
  status    OperationStatus @default(PLANNED)
  createdAt DateTime        @default(now())
}

model OperationTimeline {
  id          String   @id @default(cuid())
  operationId String
  note        String?
  timestamp   DateTime @default(now())
}

model Incident {
  id          String         @id @default(cuid())
  operationId String?
  type        IncidentType
  status      IncidentStatus @default(REPORTED)
  createdAt   DateTime       @default(now())
}

model IncidentTimeline {
  id         String   @id @default(cuid())
  incidentId String
  note       String?
  timestamp  DateTime @default(now())
}

// Investigations details
model Suspect {
  id              String @id @default(cuid())
  investigationId String
  name            String
}

model Witness {
  id              String @id @default(cuid())
  investigationId String
  name            String
}

model Interrogation {
  id              String  @id @default(cuid())
  investigationId String
  notes           String?
}

model InvestigationTimeline {
  id              String   @id @default(cuid())
  investigationId String
  note            String?
  timestamp       DateTime @default(now())
}

// Workflow
model WorkflowState {
  id   String @id @default(cuid())
  name String
}

model WorkflowTransition {
  id        String @id @default(cuid())
  fromState String
  toState   String
  name      String
}

model WorkflowApproval {
  id         String @id @default(cuid())
  refId      String
  approverId String
  status     String
}

model WorkflowEscalation {
  id         String @id @default(cuid())
  workflowId String
  rule       String
}

model WorkflowTransitionLog {
  id           String   @id @default(cuid())
  transitionId String
  metadata     Json?
  createdAt    DateTime @default(now())
}

// Prison system
model Prisoner {
  id         String         @id @default(cuid())
  fullName   String
  nationalId String?
  status     PrisonerStatus
  admittedAt DateTime?
}

model Cell {
  id       String   @id @default(cuid())
  name     String
  type     CellType
  capacity Int?
}

model DisciplinaryRecord {
  id         String  @id @default(cuid())
  prisonerId String
  notes      String?
}

model MedicalRecord {
  id         String  @id @default(cuid())
  prisonerId String
  notes      String?
}

model VisitorLog {
  id          String   @id @default(cuid())
  prisonerId  String
  visitorName String
  visitedAt   DateTime @default(now())
}
